<?xml version="1.0" encoding="UTF-8"?>
<!--
    SCB CF bulk upload page, built from Granite UI components (no HTL of our own).
    Opens at: /apps/aemcloudproject/cfbulkupload/content/cfbulkupload.html

    Renders:
      SCB CF bulk upload                                             <- page heading
      ┌ Upload workbook ────────────────────┐ ┌ Sample and report ─────┐
      │ Workbook (.xlsx) * [path][📁]       │ │ text                   │
      │ Fragment folder *  [path][📁]       │ │ [Download sample sheet]│
      │ ▸ How it works                      │ │ [Save report to DAM]   │
      │            [ Dry run ] [ Final run ]│ └────────────────────────┘
      └─────────────────────────────────────┘
      results: banner / counts / scroll box with the table   <- filled by cf-bulk-upload.js
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="SCB CF bulk upload"
    sling:resourceType="granite/ui/components/shell/page"
    consoleId="cf-bulk-upload">
    <!-- Scripts and styles for the page:
         coralui3 / granite.ui.coral.foundation / granite.ui.shell = AEM's UI widgets (path browser, buttons, accordion,
         alerts, wait spinner, confirm dialog)
         granite.csrf.standalone = adds the CSRF token to our POST
         aemcloudproject.cfbulkupload = our cf-bulk-upload.js + cf-bulk-upload.css -->
    <head jcr:primaryType="nt:unstructured">
        <clientlibs
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/includeclientlibs"
            categories="[coralui3,granite.ui.coral.foundation,granite.ui.shell,granite.csrf.standalone,aemcloudproject.cfbulkupload]"/>
    </head>
    <!-- Page body. granite:class adds a CSS class to the rendered <div>. -->
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container"
        granite:class="scb-cf-bulk-upload__page">
        <items jcr:primaryType="nt:unstructured">
            <!-- Page heading: <h1>SCB CF bulk upload</h1> -->
            <title
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/heading"
                level="{Long}1"
                text="SCB CF bulk upload"
                granite:class="scb-cf-bulk-upload__title"/>
            <!-- The two cards side by side (CSS grid in cf-bulk-upload.css; stacked on narrow screens). -->
            <cards
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                granite:class="scb-cf-bulk-upload__cards">
                <items jcr:primaryType="nt:unstructured">
                    <!-- Card 1: upload -->
                    <uploadCard
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        granite:class="scb-cf-bulk-upload__card">
                        <items jcr:primaryType="nt:unstructured">
                            <heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/heading"
                                level="{Long}2"
                                text="Upload workbook"
                                granite:class="scb-cf-bulk-upload__card-heading"/>
                            <intro
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                text="Create, update or delete content fragments from an .xlsx in DAM."
                                granite:class="scb-cf-bulk-upload__card-text"/>
                            <!-- <form class="scb-cf-bulk-upload" action=".../upload.json" method="post">.
                                 cf-bulk-upload.js catches its submit and sends it with ajax instead. -->
                            <form
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/form"
                                action="/apps/aemcloudproject/cfbulkupload/content/cfbulkupload/upload.json"
                                method="post"
                                style="vertical"
                                granite:class="scb-cf-bulk-upload">
                                <items jcr:primaryType="nt:unstructured">
                                    <!-- Path browser. name="filePath" is the parameter the servlet reads.
                                         Value after picking, e.g. /content/dam/aemcloudproject/imports/cf-import-combined.xlsx -->
                                    <filePath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Workbook (.xlsx)"
                                        emptyText="/content/dam/aemcloudproject/imports/..."
                                        name="filePath"
                                        rootPath="/content/dam/aemcloudproject/imports"
                                        required="{Boolean}true"/>
                                    <!-- Folder picker (folders only). name="rootPath" is the parameter the servlets read; the model
                                         folders (offers, merchants, ...) are under it. cf-bulk-upload.js pre-fills it with the
                                         OSGi default from GET .../upload.json. -->
                                    <rootPath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Fragment folder"
                                        emptyText="/content/dam/aemcloudproject/cfs/offer-listing"
                                        name="rootPath"
                                        rootPath="/content/dam"
                                        filter="folder"
                                        required="{Boolean}true"/>
                                    <!-- "How it works": collapsed accordion with the main rules. -->
                                    <help
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/accordion"
                                        granite:class="scb-cf-bulk-upload__help">
                                        <items jcr:primaryType="nt:unstructured">
                                            <howItWorks
                                                jcr:primaryType="nt:unstructured"
                                                jcr:title="How it works"
                                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                                <items jcr:primaryType="nt:unstructured">
                                                    <sheets
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/text"
                                                        text="One sheet per model. Row 1 holds the column names: action, slug and the model fields; red headers are mandatory."
                                                        granite:class="scb-cf-bulk-upload__help-item"/>
                                                    <action
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/text"
                                                        text="The action column says CREATE, UPDATE or DELETE. Rows with an empty action are skipped; an empty ID on a CREATE row is filled with the next ID."
                                                        granite:class="scb-cf-bulk-upload__help-item"/>
                                                    <slug
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/text"
                                                        text="The slug is the fragment's name under the picked folder, e.g. offers/summer-sale. It is not stored in the fragment."
                                                        granite:class="scb-cf-bulk-upload__help-item"/>
                                                    <delete
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/text"
                                                        text="DELETE leaves a fragment in place (Warn) while other fragments or pages point to it, or while it is published."
                                                        granite:class="scb-cf-bulk-upload__help-item"/>
                                                    <multiValue
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/text"
                                                        text="For several references, put one path per line in the cell (Alt+Enter)."
                                                        granite:class="scb-cf-bulk-upload__help-item"/>
                                                    <clear
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/text"
                                                        text="On UPDATE, a blank cell clears its field (except the ID); columns left out of the sheet are not touched."
                                                        granite:class="scb-cf-bulk-upload__help-item"/>
                                                    <start
                                                        jcr:primaryType="nt:unstructured"
                                                        sling:resourceType="granite/ui/components/coral/foundation/text"
                                                        text="Run a dry run first. Final run is enabled only when the dry run has no failures, and it saves a report of the run in DAM."
                                                        granite:class="scb-cf-bulk-upload__help-item"/>
                                                </items>
                                            </howItWorks>
                                        </items>
                                    </help>
                                    <!-- Final run: disabled until a dry run of the same workbook and folder has no failures
                                         (cf-bulk-upload.js). Listed first so it floats to the far right. -->
                                    <finalRun
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/button"
                                        type="button"
                                        text="Final run"
                                        variant="primary"
                                        disabled="{Boolean}true"
                                        granite:class="scb-cf-bulk-upload__final-run"/>
                                    <!-- type="submit": clicking it (or Enter) submits the form -> scbSubmitCfBulkUpload() runs a dry run. -->
                                    <submit
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/button"
                                        type="submit"
                                        text="Dry run"
                                        variant="secondary"
                                        granite:class="scb-cf-bulk-upload__submit"/>
                                </items>
                            </form>
                        </items>
                    </uploadCard>
                    <!-- Card 2: report -->
                    <reportCard
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        granite:class="scb-cf-bulk-upload__card">
                        <items jcr:primaryType="nt:unstructured">
                            <heading
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/heading"
                                level="{Long}2"
                                text="Sample and report"
                                granite:class="scb-cf-bulk-upload__card-heading"/>
                            <intro
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/text"
                                text="Download the empty sample sheet to author in, or save every fragment under the picked folder to a new, dated Excel file in DAM."
                                granite:class="scb-cf-bulk-upload__card-text"/>
                            <!-- "Download sample sheet": a plain link (GET .../report.xlsx -> ScbCfReportServlet.doGet)
                                 rendered as a Coral button; the browser downloads cf-bulk-upload-sample.xlsx. -->
                            <sampleButton
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/anchorbutton"
                                href="/apps/aemcloudproject/cfbulkupload/content/cfbulkupload/report.xlsx"
                                text="Download sample sheet"
                                icon="download"
                                variant="secondary"
                                granite:class="scb-cf-bulk-upload__sample"/>
                            <!-- "Save report to DAM": cf-bulk-upload.js (scbSaveReport) POSTs the picked folder to
                                 data-report-url, shows a spinner + timer meanwhile, then the saved path. The report folder
                                 and file name prefix come from the OSGi config. type="button" so it never submits anything. -->
                            <reportButton
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/button"
                                type="button"
                                text="Save report to DAM"
                                icon="upload"
                                variant="secondary"
                                granite:class="scb-cf-bulk-upload__report">
                                <!-- Rendered as data-report-url="/apps/.../report.json" on the button. -->
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    report-url="/apps/aemcloudproject/cfbulkupload/content/cfbulkupload/report.json"/>
                            </reportButton>
                            <!-- Empty <div class="scb-cf-bulk-upload__report-status">; the JS shows
                                 "Saving the report… 12 s", then "Saved …" or an error here. -->
                            <reportStatus
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container"
                                granite:class="scb-cf-bulk-upload__report-status"/>
                        </items>
                    </reportCard>
                </items>
            </cards>
            <!-- Empty <div class="scb-cf-bulk-upload__result"> under the cards, full width.
                 cf-bulk-upload.js writes the spinner, error alerts, or banner + counts + results table into it. -->
            <result
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container"
                granite:class="scb-cf-bulk-upload__result"/>
        </items>
    </content>
    <!-- Not rendered on the page. Gives the servlet a URL: Sling sees resource type
         aemcloudproject/cfbulkupload/upload on GET / POST .../upload.json and calls ScbCfBulkUploadServlet. -->
    <upload
        jcr:primaryType="nt:unstructured"
        sling:resourceType="aemcloudproject/cfbulkupload/upload"/>
    <!-- Not rendered on the page. Gives the report servlet a URL: GET .../report.xlsx (sample) and
         POST .../report.json (save report) on resource type aemcloudproject/cfbulkupload/report call ScbCfReportServlet. -->
    <report
        jcr:primaryType="nt:unstructured"
        sling:resourceType="aemcloudproject/cfbulkupload/report"/>
</jcr:root>
