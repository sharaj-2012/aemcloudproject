<?xml version="1.0" encoding="UTF-8"?>
<!-- Merged onto the core Tabs dialog: adds a "Calculator" tab next to Properties / Accessibility. -->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Goal Based Calculator Tabs"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <tabs jcr:primaryType="nt:unstructured">
                <items jcr:primaryType="nt:unstructured">
                    <calculator
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Calculator"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <column
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/container">
                                <items jcr:primaryType="nt:unstructured">
                                    <headingTitle
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Heading"
                                        name="./headingTitle"/>
                                    <headingDescription
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                                        fieldLabel="Description"
                                        name="./headingDescription"/>
                                    <yourGoalLabel
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Goal chips label"
                                        fieldDescription="Defaults to 'Your Goal'"
                                        name="./yourGoalLabel"/>
                                    <desktopImagePath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Background image (desktop)"
                                        rootPath="/content/dam"
                                        name="./desktopImagePath"/>
                                    <mobileImagePath
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Background image (mobile)"
                                        rootPath="/content/dam"
                                        name="./mobileImagePath"/>
                                    <desktopImageAltText
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Background image alt text"
                                        name="./desktopImageAltText"/>
                                    <primaryCtaLabel
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Primary CTA label"
                                        name="./primaryCtaLabel"/>
                                    <primaryCtaLink
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Primary CTA link"
                                        rootPath="/content"
                                        name="./primaryCtaLink"/>
                                    <secondaryCtaLabel
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                        fieldLabel="Secondary CTA label"
                                        name="./secondaryCtaLabel"/>
                                    <secondaryCtaLink
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                        fieldLabel="Secondary CTA link"
                                        rootPath="/content"
                                        name="./secondaryCtaLink"/>
                                </items>
                            </column>
                        </items>
                    </calculator>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
