<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Responsive Image"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/container"
        granite:class="cmp-responsiveimage__editor">
        <items jcr:primaryType="nt:unstructured">
            <tabs
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/tabs"
                maximized="{Boolean}true">
                <items jcr:primaryType="nt:unstructured">
                    <asset
                        jcr:primaryType="nt:unstructured"
                        sling:hideResource="{Boolean}true"/>
                    <metadata
                        jcr:primaryType="nt:unstructured"
                        sling:hideResource="{Boolean}true"/>
                    <desktop
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Desktop Image"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <file
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                allowUpload="{Boolean}false"
                                                autoStart="{Boolean}false"
                                                class="cq-droptarget"
                                                fieldLabel="Desktop image asset"
                                                fileNameParameter="./desktopImageName"
                                                fileReferenceParameter="./desktopImagePath"
                                                mimeTypes="[image/gif,image/jpeg,image/png,image/svg+xml,image/tiff,image/webp]"
                                                multiple="{Boolean}false"
                                                name="./desktopImageFile"
                                                title="Drag a DAM image here, or pick one with the asset selector"
                                                uploadUrl="${suffix.path}"
                                                useHTML5="{Boolean}true"/>
                                            <altValueFromDAM
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                checked="{Boolean}true"
                                                name="./desktopAltValueFromDAM"
                                                text="Get alternative text from DAM metadata"
                                                uncheckedValue="false"
                                                value="{Boolean}true"/>
                                            <alt
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldDescription="Used when 'Get alternative text from DAM metadata' is unchecked."
                                                fieldLabel="Alternative text"
                                                name="./desktopAltText"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </desktop>
                    <mobile
                        jcr:primaryType="nt:unstructured"
                        jcr:title="Mobile Image"
                        sling:resourceType="granite/ui/components/coral/foundation/container"
                        margin="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <columns
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns"
                                margin="{Boolean}true">
                                <items jcr:primaryType="nt:unstructured">
                                    <column
                                        jcr:primaryType="nt:unstructured"
                                        sling:resourceType="granite/ui/components/coral/foundation/container">
                                        <items jcr:primaryType="nt:unstructured">
                                            <file
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                                                allowUpload="{Boolean}false"
                                                autoStart="{Boolean}false"
                                                class="cq-droptarget"
                                                fieldLabel="Mobile image asset"
                                                fieldDescription="Optional. When empty, the desktop image is rendered on all devices and the responsive srcset covers small screens."
                                                fileNameParameter="./mobileImageName"
                                                fileReferenceParameter="./mobileImagePath"
                                                mimeTypes="[image/gif,image/jpeg,image/png,image/svg+xml,image/tiff,image/webp]"
                                                multiple="{Boolean}false"
                                                name="./mobileImageFile"
                                                title="Drag a DAM image here, or pick one with the asset selector"
                                                uploadUrl="${suffix.path}"
                                                useHTML5="{Boolean}true"/>
                                            <altValueFromDAM
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/checkbox"
                                                checked="{Boolean}true"
                                                name="./mobileAltValueFromDAM"
                                                text="Get alternative text from DAM metadata"
                                                uncheckedValue="false"
                                                value="{Boolean}true"/>
                                            <alt
                                                jcr:primaryType="nt:unstructured"
                                                sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                                fieldDescription="Used when 'Get alternative text from DAM metadata' is unchecked."
                                                fieldLabel="Alternative text"
                                                name="./mobileAltText"/>
                                        </items>
                                    </column>
                                </items>
                            </columns>
                        </items>
                    </mobile>
                </items>
            </tabs>
        </items>
    </content>
</jcr:root>
