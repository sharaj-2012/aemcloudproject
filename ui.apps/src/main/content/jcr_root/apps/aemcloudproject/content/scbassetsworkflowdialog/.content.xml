<?xml version="1.0" encoding="UTF-8"?>
<!--
    SCB Workflows dialog for the Assets console.

    Copy of the OOTB /libs/dam/gui/content/commons/createworkflowdialog, keeping its classes so
    the OOTB Assets workflow script handles submit (folder/collection expansion, the confirmation
    warning, the multiple-workflow limit and notifications). The only difference is the model
    select, which lists just the model passed as ?model=, preselected.
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Create Workflow"
    sling:resourceType="granite/ui/components/coral/foundation/dialog"
    granite:class="cq-common-admin-timeline-toolbar-actions-workflow-dialog"
    granite:rel="cq-common-admin-timeline-toolbar-actions-workflow">
    <items jcr:primaryType="nt:unstructured">
        <form
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/form"
            action="/etc/workflow/instances"
            granite:rel="cq-common-admin-timeline-toolbar-actions-workflow-form"
            style="vertical">
            <granite:data
                jcr:primaryType="nt:unstructured"
                errormessage="Cannot start workflow on this page."/>
            <items jcr:primaryType="nt:unstructured">
                <charset
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/foundation/form/hidden"
                    name="_charset_"
                    value="utf-8"/>
                <status
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                    ignoreData="{Boolean}true"
                    name=":status"
                    value="browser"/>
                <payloadtype
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/form/hidden"
                    ignoreData="{Boolean}true"
                    name="payloadType"
                    value="JCR_PATH"/>
                <model
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/form/select"
                    emptyText="Select a Workflow Model"
                    fieldLabel="Select Workflow Model"
                    granite:rel="cq-common-admin-timeline-toolbar-actions-workflow-select"
                    ignoreData="{Boolean}true"
                    name="model"
                    required="{Boolean}true">
                    <datasource
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="aemcloudproject/components/authoring/scbworkflowmodels"
                        expandFolders="{Boolean}true"
                        models="[/var/workflow/models/request_for_activation,/var/workflow/models/request_for_deactivation]"/>
                </model>
                <workflowtitle
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                    emptyText="Enter title of workflow"
                    fieldLabel="Enter title of workflow"
                    ignoreData="{Boolean}true"
                    name="workflowTitle"/>
            </items>
        </form>
    </items>
    <footer jcr:primaryType="nt:unstructured">
        <cancel
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/button"
            text="Cancel">
            <parentConfig
                jcr:primaryType="nt:unstructured"
                close="{Boolean}true"/>
        </cancel>
        <save
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/button"
            granite:class="foundation-toggleable-control"
            granite:rel="cq-common-admin-timeline-toolbar-actions-workflow-action-ok"
            text="Start"
            trackingFeature="aem:assets:workflow:run"
            variant="primary"/>
    </footer>
</jcr:root>
