<?xml version="1.0" encoding="UTF-8"?>
<!--
    SCB Workflows pulldown for the Assets console selection bar, placed after Create.
    Visibility, selection rules and the dialog action mirror the OOTB Create > Workflow item.
    relScope="none": the console only shows a selection action when the selected card lists
    its granite:rel, and DAM cards list only OOTB rels, so our custom rels must not be checked.
-->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="nt:unstructured"
    sling:resourceType="granite/ui/components/coral/foundation/pulldown"
    sling:orderBefore="extractarchive"
    granite:class="foundation-collection-action scb-workflows"
    granite:rel="scb-damadmin-admin-actions-scbworkflows-activator"
    icon="workflow"
    text="SCB Workflows"
    variant="actionBar">
    <granite:data
        jcr:primaryType="nt:unstructured"
        foundation-collection-action="\{&quot;target&quot;: &quot;.cq-damadmin-admin-childpages&quot;, &quot;activeSelectionCount&quot;: &quot;multiple&quot;, &quot;relScope&quot;: &quot;none&quot;}"/>
    <granite:rendercondition
        jcr:primaryType="nt:unstructured"
        sling:resourceType="dam/gui/coral/components/commons/renderconditions/mainasset"/>
    <items jcr:primaryType="nt:unstructured">
        <requestactivation
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/collection/actionlink"
            action="foundation.dialog"
            activeSelectionCount="multiple"
            relScope="none"
            granite:class="cq-damadmin-admin-checkout-restricted"
            granite:rel="scb-damadmin-admin-actions-requestactivation"
            target=".cq-damadmin-admin-childpages"
            text="Request for Activation">
            <data
                jcr:primaryType="nt:unstructured"
                nesting="hide"
                src.uritemplate="/mnt/overlay/aemcloudproject/content/scbassetsworkflowdialog.html?model=/var/workflow/models/request_for_activation"/>
            <granite:rendercondition
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/renderconditions/canreadworkflowmodels"/>
        </requestactivation>
        <requestdeactivation
            jcr:primaryType="nt:unstructured"
            sling:resourceType="granite/ui/components/coral/foundation/collection/actionlink"
            action="foundation.dialog"
            activeSelectionCount="multiple"
            relScope="none"
            granite:class="cq-damadmin-admin-checkout-restricted"
            granite:rel="scb-damadmin-admin-actions-requestdeactivation"
            target=".cq-damadmin-admin-childpages"
            text="Request for Deactivation">
            <data
                jcr:primaryType="nt:unstructured"
                nesting="hide"
                src.uritemplate="/mnt/overlay/aemcloudproject/content/scbassetsworkflowdialog.html?model=/var/workflow/models/request_for_deactivation"/>
            <granite:rendercondition
                jcr:primaryType="nt:unstructured"
                sling:resourceType="cq/gui/components/renderconditions/canreadworkflowmodels"/>
        </requestdeactivation>
    </items>
</jcr:root>
