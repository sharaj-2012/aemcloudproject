<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured">
    <header jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <headerbar jcr:primaryType="nt:unstructured">
                <items jcr:primaryType="nt:unstructured">
                    <scbworkflows
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/pulldown"
                        sling:orderBefore="preview"
                        granite:class="editor-GlobalBar-item scb-workflows"
                        granite:title="SCB Workflows"
                        text="SCB Workflows"
                        align="left"
                        variant="minimal">
                        <items jcr:primaryType="nt:unstructured">
                            <requestactivation
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/hyperlink"
                                granite:class="scb-workflow-action"
                                href="#"
                                text="Request for Activation">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    workflow-model="/var/workflow/models/request_for_activation"
                                    workflow-name="Request for Activation"/>
                            </requestactivation>
                            <requestdeactivation
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="granite/ui/components/coral/foundation/hyperlink"
                                granite:class="scb-workflow-action"
                                href="#"
                                text="Request for Deactivation">
                                <granite:data
                                    jcr:primaryType="nt:unstructured"
                                    workflow-model="/var/workflow/models/request_for_deactivation"
                                    workflow-name="Request for Deactivation"/>
                            </requestdeactivation>
                        </items>
                    </scbworkflows>
                </items>
            </headerbar>
        </items>
    </header>
    <content jcr:primaryType="nt:unstructured">
        <items jcr:primaryType="nt:unstructured">
            <scbstartworkflowmodal
                jcr:primaryType="nt:unstructured"
                sling:resourceType="aemcloudproject/components/authoring/scbstartworkflow"
                models="[/var/workflow/models/request_for_activation,/var/workflow/models/request_for_deactivation]"/>
        </items>
    </content>
</jcr:root>
