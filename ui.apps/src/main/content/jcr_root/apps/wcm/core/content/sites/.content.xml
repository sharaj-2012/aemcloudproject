<?xml version="1.0" encoding="UTF-8"?>
<!-- Overlay of /libs/wcm/core/content/sites: show the Sites console Delete action only to administrators.
     Uses the OOTB privilege render condition: only admin / administrators hold jcr:modifyAccessControl on /content. -->
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content jcr:primaryType="nt:unstructured">
        <actions jcr:primaryType="nt:unstructured">
            <selection jcr:primaryType="nt:unstructured">
                <deletepage jcr:primaryType="nt:unstructured">
                    <granite:rendercondition
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/renderconditions/privilege"
                        path="/content"
                        privileges="[jcr:modifyAccessControl]"/>
                </deletepage>
            </selection>
        </actions>
    </jcr:content>
</jcr:root>
