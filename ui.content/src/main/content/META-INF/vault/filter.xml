<?xml version="1.0" encoding="UTF-8"?>
<workspaceFilter version="1.0">
    <!-- CF models are managed in code: "update" applies changed properties to existing models,
         which "merge" never does. FileVault takes the mode from the first filter covering a path,
         so this must stay above the /conf/aemcloudproject filter. -->
    <filter root="/conf/aemcloudproject/settings/dam/cfm/models" mode="update"/>
    <filter root="/conf/aemcloudproject" mode="merge">
        <exclude pattern="/conf/aemcloudproject/settings/dam/cfm/models(/.*)?"/>
    </filter>
    <filter root="/content/aemcloudproject" mode="merge"/>
    <filter root="/content/cq:graphql/aemcloudproject"/>
    <filter root="/content/dam/aemcloudproject" mode="merge">
        <exclude pattern="/content/dam/aemcloudproject(/.*)?"/>
        <include pattern="/content/dam/aemcloudproject/jcr:content(/.*)?"/>
    </filter>
    <filter root="/content/dam/aemcloudproject/asset.jpg" mode="merge"/>
    <filter root="/content/experience-fragments/aemcloudproject" mode="merge"/>
</workspaceFilter>
