query allProjects {
  demoBookList {
    items {
      _path
      firstName
      lastName
      emailId
      hobbies
      dateOfBirth
      tellMeAboutYourself {
        plaintext
      }
      isEmployed
      jobType
      salary
      uploadPhoto {
        ... on ImageRef {
          _path
        }
      }
      projectsCompleted {
        ... on ProjectCfModelModel {
          projectName
          projectDescription {
            plaintext
          }
        }
      }
    }
  }
}
